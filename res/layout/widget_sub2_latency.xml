<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <!-- 1. 顶栏：微光状态点 + 标题 (完整不截断) + 弹性留白 + 当前账户胶囊 + 时间戳 + 快捷刷新/设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_dot_status" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="SS2A · 性能耗时"
            android:textColor="#F8FAFC"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- 弹性留白垫片 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 顶栏当前上游账户胶囊 -->
        <TextView
            android:id="@+id/tv_top_account"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_badge_account"
            android:gravity="center"
            android:includeFontPadding="false"
            android:ellipsize="middle"
            android:maxWidth="90dp"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="gugugaga"
            android:textColor="#60A5FA"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="--:--"
            android:textColor="#64748B"
            android:textSize="9sp" />

        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="5dp"
            android:layout_gravity="center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- 错误异常提示条 (默认隐藏) -->
    <TextView
        android:id="@+id/tv_error_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:background="#20EF4444"
        android:gravity="center"
        android:padding="2dp"
        android:text="连接受阻，点击重试"
        android:textColor="#FCA5A5"
        android:textSize="9sp"
        android:visibility="gone" />

    <!-- 2. 专业微型表头栏 (1:1 绝对卡位对齐下方各列) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp">

        <!-- 表头：模型 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="模型"
            android:textColor="#64748B"
            android:textSize="8sp" />

        <!-- 表头：渠道 (45dp, center) -->
        <TextView
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="渠道"
            android:textColor="#64748B"
            android:textSize="8sp" />

        <!-- 表头：首字 (38dp, end, 天蓝) -->
        <TextView
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:gravity="end"
            android:includeFontPadding="false"
            android:text="首字"
            android:textColor="#38BDF8"
            android:textSize="8sp" />

        <!-- 表头：总耗 (38dp, end, 翡翠绿) -->
        <TextView
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:gravity="end"
            android:includeFontPadding="false"
            android:text="总耗"
            android:textColor="#34D399"
            android:textSize="8sp" />

        <!-- 表头：时间 (40dp, end, 冷灰) -->
        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:includeFontPadding="false"
            android:text="时间"
            android:textColor="#64748B"
            android:textSize="8sp" />
    </LinearLayout>

    <!-- 3. 最近 4 条性能调用记录列表区域 (等宽 monospace 严密栅格) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="3dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 第 1 条记录 -->
        <LinearLayout
            android:id="@+id/layout_log_item_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="2.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_log_item_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <TextView
                android:id="@+id/tv_log_model_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="暂无记录"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_account_1"
                android:layout_width="45dp"
                android:layout_height="17dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_badge_account"
                android:gravity="center"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="--"
                android:textColor="#93C5FD"
                android:textSize="7.5sp" />

            <TextView
                android:id="@+id/tv_log_first_token_1"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="3dp"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="0s"
                android:textColor="#38BDF8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_log_duration_1"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="3dp"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="0s"
                android:textColor="#34D399"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_time_1"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="--:--:--"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- 第 2 条记录 -->
        <LinearLayout
            android:id="@+id/layout_log_item_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="1.5dp"
            android:layout_marginBottom="2.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_log_item_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <TextView
                android:id="@+id/tv_log_model_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="暂无记录"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_account_2"
                android:layout_width="45dp"
                android:layout_height="17dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_badge_account"
                android:gravity="center"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="--"
                android:textColor="#93C5FD"
                android:textSize="7.5sp" />

            <TextView
                android:id="@+id/tv_log_first_token_2"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="3dp"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="0s"
                android:textColor="#38BDF8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_log_duration_2"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="3dp"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="0s"
                android:textColor="#34D399"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_time_2"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="--:--:--"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- 第 3 条记录 -->
        <LinearLayout
            android:id="@+id/layout_log_item_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="1.5dp"
            android:layout_marginBottom="2.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_log_item_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <TextView
                android:id="@+id/tv_log_model_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="暂无记录"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_account_3"
                android:layout_width="45dp"
                android:layout_height="17dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_badge_account"
                android:gravity="center"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="--"
                android:textColor="#93C5FD"
                android:textSize="7.5sp" />

            <TextView
                android:id="@+id/tv_log_first_token_3"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="3dp"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="0s"
                android:textColor="#38BDF8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_log_duration_3"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="3dp"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="0s"
                android:textColor="#34D399"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_time_3"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="--:--:--"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- 第 4 条记录 -->
        <LinearLayout
            android:id="@+id/layout_log_item_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="1.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_log_item_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <TextView
                android:id="@+id/tv_log_model_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="暂无记录"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_account_4"
                android:layout_width="45dp"
                android:layout_height="17dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_badge_account"
                android:gravity="center"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="--"
                android:textColor="#93C5FD"
                android:textSize="7.5sp" />

            <TextView
                android:id="@+id/tv_log_first_token_4"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="3dp"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="0s"
                android:textColor="#38BDF8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_log_duration_4"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="3dp"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="0s"
                android:textColor="#34D399"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_time_4"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="--:--:--"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. 底栏性能汇总 -->
    <TextView
        android:id="@+id/tv_bottom_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="平均耗时: 0s · 0 RPM"
        android:textColor="#64748B"
        android:textSize="10sp" />
</LinearLayout>