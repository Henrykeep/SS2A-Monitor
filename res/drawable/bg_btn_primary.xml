<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:angle="135"
                android:startColor="#059669"
                android:centerColor="#047857"
                android:endColor="#065F46"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#10B981" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:angle="135"
                android:startColor="#34D399"
                android:centerColor="#10B981"
                android:endColor="#059669"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#6EE7B7" />
        </shape>
    </item>
</selector>
