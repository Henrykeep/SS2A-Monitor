<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#3E2769"
                android:centerColor="#2A194C"
                android:endColor="#1C1033"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#A78BFA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#2D1C4D"
                android:centerColor="#1E1236"
                android:endColor="#130B24"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#5C369E" />
        </shape>
    </item>
</selector>