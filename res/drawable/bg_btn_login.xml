<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:angle="135"
                android:startColor="#A78BFA"
                android:centerColor="#8B5CF6"
                android:endColor="#7C3AED"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#C4B5FD" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:angle="135"
                android:startColor="#DDB6F2"
                android:centerColor="#CBA6F7"
                android:endColor="#A78BFA"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#F5C2E7" />
        </shape>
    </item>
</selector>
