<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶部状态与刷新 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_status_dot"
            android:layout_width="7.5dp"
            android:layout_height="7.5dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_dot_status" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SS2A 消耗"
            android:textColor="#CBA6F7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_widget_btn"
            android:contentDescription="刷新"
            android:padding="4dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <!-- 中部今日花费大字 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日消耗"
            android:textColor="#34D399"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_today_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="$0.00"
            android:textColor="#10B981"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_today_requests"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="0 次请求"
            android:textColor="#60A5FA"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- 底部更新时间 -->
    <TextView
        android:id="@+id/tv_update_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_widget_tag"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="--:--"
        android:textColor="#94A3B8"
        android:textSize="9sp" />
</LinearLayout>
