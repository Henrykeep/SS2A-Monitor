<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <!-- 1. 顶栏：微光状态点 + 标题 (完整不截断) + 弹性留白 + 当前账户胶囊 + 时间戳 + 快捷刷新/设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_dot_status" />

        <!-- 标题：严格 wrap_content 保证「调用明细」四个大字 100% 完整显示，严禁任何省略号！ -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="SS2A · 性能耗时"
            android:textColor="#F8FAFC"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- 弹性留白垫片：使用 RemoteViews 白名单严格支持的 LinearLayout -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 顶栏账户胶囊：绝对居中 -->
        <TextView
            android:id="@+id/tv_top_account"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:layout_marginEnd="4dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_badge_account"
            android:gravity="center"
            android:includeFontPadding="false"
            android:ellipsize="middle"
            android:maxWidth="90dp"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="--"
            android:textColor="#38BDF8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- 时间戳胶囊 -->
        <TextView
            android:id="@+id/tv_update_time"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:layout_marginEnd="5dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_widget_tag"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="--:--"
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_widget_btn"
            android:contentDescription="立即刷新"
            android:padding="4dp"
            android:src="@drawable/ic_refresh" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_widget_btn"
            android:contentDescription="配置设置"
            android:padding="4dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- 异常提示条 -->
    <TextView
        android:id="@+id/tv_error_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F87171"
        android:textSize="9sp"
        android:visibility="gone" 
        android:includeFontPadding="false" />

    <!-- 2. 最近使用记录列表区域 (4条紧凑极客卡片，严格固定列宽网格对齐) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 第 1 条记录 -->
        <LinearLayout
            android:id="@+id/layout_log_item_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="2.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_log_item_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <!-- 列 1：模型名称 (左对齐，弹性填补剩余宽度，拥有充裕的 140dp+ 空间，100% 完整显示不截断！) -->
            <TextView
                android:id="@+id/tv_log_model_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="暂无调用记录"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- 列 2：上游账户胶囊 (严格锁定 45dp 固定宽度，X坐标垂直绝对一条线) -->
            <TextView
                android:id="@+id/tv_log_account_1"
                android:layout_width="45dp"
                android:layout_height="17dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_badge_account"
                android:gravity="center"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="--"
                android:textColor="#93C5FD"
                android:textSize="7.5sp" />

            <!-- 列 3：首字延迟 TTFT (严格锁定 33dp 固定宽度，右对齐，monospace 等宽字体) -->
            <TextView
                android:id="@+id/tv_log_first_token_1"
                android:layout_width="33dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:layout_marginEnd="4dp"
                android:singleLine="true"
                android:text="--"
                android:textColor="#38BDF8"
                android:textSize="8.5sp" />

            <!-- 列 4：消费金额 (严格锁定 39dp 固定宽度，全行右对齐) -->
            <TextView
                android:id="@+id/tv_log_duration_1"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:layout_marginEnd="2dp"
                android:singleLine="true"
                android:text="0s"
                android:textColor="#34D399"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- 列 5：时间戳 (严格锁定 40dp 固定宽度，带秒数 HH:mm:ss 完整显示，全行右对齐) -->
            <TextView
                android:id="@+id/tv_log_time_1"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:singleLine="true"
                android:text="--:--:--"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- 第 2 条记录 -->
        <LinearLayout
            android:id="@+id/layout_log_item_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="1.5dp"
            android:layout_marginBottom="2.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_log_item_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <TextView
                android:id="@+id/tv_log_model_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="--"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_log_account_2"
                android:layout_width="45dp"
                android:layout_height="17dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_badge_account"
                android:gravity="center"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="--"
                android:textColor="#93C5FD"
                android:textSize="7.5sp" />

            <TextView
                android:id="@+id/tv_log_first_token_2"
                android:layout_width="33dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:layout_marginEnd="4dp"
                android:singleLine="true"
                android:text="--"
                android:textColor="#38BDF8"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/tv_log_duration_2"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:layout_marginEnd="2dp"
                android:singleLine="true"
                android:text="0s"
                android:textColor="#34D399"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_time_2"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:singleLine="true"
                android:text="--:--:--"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- 第 3 条记录 -->
        <LinearLayout
            android:id="@+id/layout_log_item_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="1.5dp"
            android:layout_marginBottom="2.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_log_item_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <TextView
                android:id="@+id/tv_log_model_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="--"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_log_account_3"
                android:layout_width="45dp"
                android:layout_height="17dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_badge_account"
                android:gravity="center"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="--"
                android:textColor="#93C5FD"
                android:textSize="7.5sp" />

            <TextView
                android:id="@+id/tv_log_first_token_3"
                android:layout_width="33dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:layout_marginEnd="4dp"
                android:singleLine="true"
                android:text="--"
                android:textColor="#38BDF8"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/tv_log_duration_3"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:layout_marginEnd="2dp"
                android:singleLine="true"
                android:text="0s"
                android:textColor="#34D399"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_time_3"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:singleLine="true"
                android:text="--:--:--"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- 第 4 条记录 -->
        <LinearLayout
            android:id="@+id/layout_log_item_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="1.5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_log_item_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <TextView
                android:id="@+id/tv_log_model_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="--"
                android:textColor="#CBD5E1"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_log_account_4"
                android:layout_width="45dp"
                android:layout_height="17dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_badge_account"
                android:gravity="center"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="--"
                android:textColor="#93C5FD"
                android:textSize="7.5sp" />

            <TextView
                android:id="@+id/tv_log_first_token_4"
                android:layout_width="33dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:layout_marginEnd="4dp"
                android:singleLine="true"
                android:text="--"
                android:textColor="#38BDF8"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/tv_log_duration_4"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:layout_marginEnd="2dp"
                android:singleLine="true"
                android:text="0s"
                android:textColor="#34D399"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_time_4"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:typeface="monospace"
                android:singleLine="true"
                android:text="--:--:--"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. 底栏汇总简报 -->
    <TextView
        android:id="@+id/tv_bottom_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="今日: $0.00 (0次) · 0 RPM"
        android:textColor="#64748B"
        android:textSize="10sp" 
        android:includeFontPadding="false" />
</LinearLayout>