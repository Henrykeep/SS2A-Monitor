<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#11111B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SS2A 运营监控"
            android:textColor="#CDD6F4"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sub2API 桌面小组件配置中心 (实时模式)"
            android:textColor="#A6ADC8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E1E2E"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sub2API 站点域名"
                android:textColor="#BAC2DE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_server_url"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#313244"
                android:hint="https://ss2a.top"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="https://ss2a.top"
                android:textColor="#CDD6F4"
                android:textColorHint="#585B70"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="管理员一键登录 (推荐，自动续期)"
                android:textColor="#BAC2DE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_admin_account"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#313244"
                android:hint="管理员账号 / 邮箱"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#CDD6F4"
                android:textColorHint="#585B70"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_admin_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#313244"
                android:hint="管理员密码"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#CDD6F4"
                android:textColorHint="#585B70"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_quick_login"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="#CBA6F7"
                android:text="一键登录并获取 Token"
                android:textColor="#11111B"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="或手动输入 Token (高级)"
                android:textColor="#A6ADC8"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_admin_token"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#313244"
                android:hint="登录后自动填入，也可手动粘贴"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#CDD6F4"
                android:textColorHint="#585B70"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="实时刷新频率 (秒，亮屏时执行)"
                android:textColor="#BAC2DE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_refresh_interval"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#313244"
                android:hint="默认 30 秒 (支持 5 ~ 300 秒)"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="30"
                android:textColor="#CDD6F4"
                android:textColorHint="#585B70"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_test_connection"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="#45475A"
                    android:text="测试连接"
                    android:textColor="#CDD6F4" />

                <Button
                    android:id="@+id/btn_save_config"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#89B4FA"
                    android:text="保存并启动实时监控"
                    android:textColor="#11111B"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_test_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#181825"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 极速实时刷新说明"
                android:textColor="#A6E3A1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• 亮屏期间：按照设定的秒数（默认30秒，最快5秒）极速轮询实时刷新；
• 解锁亮屏：立即无感拉取最新数据；
• 息屏待机：智能降频以节省电池电量；
• 无需手动点击，后台静默保持最新！"
                android:textColor="#A6ADC8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>