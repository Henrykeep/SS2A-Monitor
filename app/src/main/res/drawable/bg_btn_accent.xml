<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:angle="135"
                android:startColor="#60A5FA"
                android:centerColor="#3B82F6"
                android:endColor="#2563EB"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#93C5FD" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:angle="135"
                android:startColor="#93C5FD"
                android:centerColor="#60A5FA"
                android:endColor="#3B82F6"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#BFDBFE" />
        </shape>
    </item>
</selector>
