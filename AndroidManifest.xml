<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="top.ss2a.widget"
    android:versionCode="17"
    android:versionName="1.8.5">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="SS2A 监控"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="true"
        android:allowBackup="true">

        <!-- 主设置页面 -->
        <activity
            android:name="top.ss2a.widget.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面小组件广播接收器 (今日消耗 4x2) -->
        <receiver
            android:name="top.ss2a.widget.Sub2WidgetProvider"
            android:label="@string/widget_title_4x2"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="top.ss2a.widget.ACTION_MANUAL_REFRESH" />
                <action android:name="top.ss2a.widget.ACTION_AUTO_ALARM_TICK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="android.intent.action.POWER_CONNECTED" />
                <action android:name="android.intent.action.POWER_DISCONNECTED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sub2_4x2_info" />
        </receiver>

        <!-- 全量用量大看板桌面小组件广播接收器 (4x3) -->
        <receiver
            android:name="top.ss2a.widget.Sub2FullStatsWidgetProvider"
            android:label="@string/widget_title_full"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="top.ss2a.widget.ACTION_MANUAL_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sub2_full_stats_info" />
        </receiver>

        <!-- 最近调用明细桌面小组件广播接收器 (4x3) -->
        <receiver
            android:name="top.ss2a.widget.Sub2LogsWidgetProvider"
            android:label="@string/widget_title_logs"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="top.ss2a.widget.ACTION_MANUAL_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sub2_logs_info" />
        </receiver>

        <!-- 秒级极速实时常驻前台服务 -->
        <service
            android:name="top.ss2a.widget.Sub2RealtimeService"
            android:exported="true" />

        <!-- 系统定期后台作业兜底服务 -->
        <service
            android:name="top.ss2a.widget.Sub2JobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

    
        <!-- 第 4 个小组件：最近调用性能与首字延迟看板 (4x3) -->
        <receiver
            android:name=".Sub2LatencyWidgetProvider"
            android:exported="true"
            android:label="@string/widget_title_latency">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="top.ss2a.widget.ACTION_MANUAL_REFRESH" />
                <action android:name="top.ss2a.widget.LATENCY_MANUAL_REFRESH" />
                <action android:name="top.ss2a.widget.LOGS_MANUAL_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sub2_latency_info" />
        </receiver>
    </application>
</manifest>
