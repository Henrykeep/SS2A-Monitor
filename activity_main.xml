<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#11111B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题头 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SS2A 运营监控"
            android:textColor="#CDD6F4"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sub2API 桌面小组件配置中心"
            android:textColor="#A6ADC8"
            android:textSize="14sp" />

        <!-- 配置卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E1E2E"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 域名设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 Sub2API 站点域名"
                android:textColor="#BAC2DE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_server_url"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#313244"
                android:hint="例如: https://ss2a.top"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="https://ss2a.top"
                android:textColor="#CDD6F4"
                android:textColorHint="#585B70"
                android:textSize="14sp" />

            <!-- 登录模式切换或账号密码快速登录 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="🔐 管理员一键登录 (推荐，免抓包自动续期)"
                android:textColor="#BAC2DE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_admin_account"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#313244"
                android:hint="管理员账号 / 邮箱"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#CDD6F4"
                android:textColorHint="#585B70"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_admin_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#313244"
                android:hint="管理员密码"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#CDD6F4"
                android:textColorHint="#585B70"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_quick_login"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#CBA6F7"
                android:text="⚡ 一键登录并拉取 Token"
                android:textColor="#11111B"
                android:textStyle="bold" />

            <!-- 或手动填入 Token（备用选项） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="🔑 或手动填入 Token / API Key (高级)"
                android:textColor="#A6ADC8"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_admin_token"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#313244"
                android:hint="若已登录将自动填入此处"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#CDD6F4"
                android:textColorHint="#585B70"
                android:textSize="13sp" />

            <!-- 刷新间隔 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="⏱️ 后台自动刷新频率"
                android:textColor="#BAC2DE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_15m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="15 分钟"
                    android:textColor="#CDD6F4" />

                <RadioButton
                    android:id="@+id/rb_30m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="30 分钟"
                    android:textColor="#CDD6F4" />

                <RadioButton
                    android:id="@+id/rb_60m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="1 小时"
                    android:textColor="#CDD6F4" />
            </RadioGroup>

            <!-- 操作按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_test_connection"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#45475A"
                    android:text="测试连接"
                    android:textColor="#CDD6F4" />

                <Button
                    android:id="@+id/btn_save_config"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#89B4FA"
                    android:text="保存并同步"
                    android:textColor="#11111B" />
            </LinearLayout>

            <!-- 测试中进度条与测试输出 -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_test_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 添加到桌面操作说明 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#181825"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 如何将小组件添加到手机桌面？"
                android:textColor="#F9E2AF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="1. 返回手机主屏幕，长按桌面空白处；\n2. 点击【微件】/【小组件】(Widgets)；\n3. 找到【SS2A 监控】，选择 4x2 横卡或 2x2 方卡拖动至桌面；\n4. 小组件会自动按设置周期静默刷新，也可以随时点击组件右上角 ⟳ 按钮手动即时刷新。"
                android:textColor="#A6ADC8"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>